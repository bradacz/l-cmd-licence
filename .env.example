# Example only. Generate your own random keys; never commit the resulting .env.
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_BASE_PATH=
APP_KEY=
LICENSE_SALT=
ADMIN_BEARER_TOKEN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=license_server
DB_USERNAME=license_app
DB_PASSWORD=

# Explicit, comma-separated browser origins. Empty means no cross-origin access.
CORS_ALLOWED_ORIGINS=
CUSTOMER_PORTAL_URL=http://127.0.0.1:3000

# External integrations are not configured in this public example.
MAIL_ENABLED=0
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.invalid
MAIL_FROM_NAME="L-CMD License Server"
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
